# Zero_MCP 环境变量模板
# 复制此文件为 .env 并填入实际值；.env 已 gitignore，不提交。

# ── 桌面屏幕能力（Task 3-6）────────────────────────────────────────────────────
# feature flag：false=禁用（默认），true=启用所有桌面工具
SCREEN_CAPABILITY_ENABLED=false

# 感知设备选择：auto（CUDA>DML>CPU 自动降级）| cpu | dml | cuda
PERCEPTION_DEVICE=auto

# 截图临时目录（空=系统 TEMP/zero_mcp_screenshots/）
SCREENSHOT_TMP_DIR=

# UIA 空洞探测阈值：一层子元素数 ≤ 该值时判 hollow（工程假设初值 3）
UIA_HOLLOW_THRESHOLD=3

# OmniParser 本地模型目录（空=不启用 OmniParser）
OMNIPARSER_MODEL_DIR=

# OmniParser 启用所需最低 GPU 显存（MB，工程假设初值 4096）
OMNIPARSER_MIN_VRAM_MB=4096

# ── 编排层状态窗口（orchestration）──────────────────────────────────────────────
# 本节 STATE_STEP_KEEP / STALL_MAX_STEPS / STALL_THRESHOLD 三项**已接线**（分别在
# src/orchestration/state.py:120、desktop_graph.py:71、desktop_graph.py:74 读 os.environ）；
# 只有 CONTEXT_STEP_WINDOW 未接线，见下。
# ⚠ 本仓**不调用 load_dotenv**：本文件是给人看的口径清单，写进 .env 不会自动生效——
#   真正生效靠进程环境（自行 export / 由外部加载器注入 / stdio 模式下 client 整份透传给子进程）。
# Checkpointer 保留的最大步骤数
STATE_STEP_KEEP=20

# 注入上下文的步骤窗口大小 —— ⚠ **不走 env**：值写死在 src/orchestration/prompt_loader.py:36
# （`CONTEXT_STEP_WINDOW: int = 10`，该模块根本没 import os），**在 .env 里设它无效**；
# 唯一可调路径是 PromptLoader(step_window=...) 入参（prompt_loader.py:140）。
# CONTEXT_STEP_WINDOW=10

# 停滞检测：最大步骤数
STALL_MAX_STEPS=5

# 停滞检测：相似步骤阈值
STALL_THRESHOLD=3

# ── 编排层：安全门 TOCTOU（Task 7）─────────────────────────────
# 两次截图间隔（毫秒）。Task 12 实测：单快照延迟 ~1.2s，200ms 是安全下限，保留。
TOCTOU_WAIT_MS=200
# 感知哈希差异阈值：delta > 该值判定画面被篡改则 abort。
# Task 12 实测（notes/e2e-desktop-task-results.md §四.2/§五）：现代应用窗口自身有
# 持续动效（动画/红点/时钟），全窗口 phash 无静止基线（钉钉 delta 在 0/0.47 间跳）。
# 故坐标动作按 TOCTOU_CROP_HALF_PX 邻域局部裁剪比对，0.1 在该口径下成立；
# 不要为容忍动画调高此值——会失去对真实劫持的敏感度。
TOCTOU_HASH_THRESHOLD=0.1
# 坐标动作 TOCTOU 裁剪半径（像素）：以点击点为中心 2N×2N 邻域取 hash。
# 工程假设初值：覆盖常见按钮/菜单目标、小于动画区典型距离；动效恰在目标上时
# abort 是正确行为（目标不稳定不该点）。
TOCTOU_CROP_HALF_PX=150

# ── 编排层：停滞检测信号 A（Task 10）───────────────────────────
# phash 汉明距离 < 该值视为画面未变化。同受应用动画影响（同窗口级 hash 局限，
# 待与 TOCTOU 一并评估元素级裁剪口径，Task 12 §四.2）。
PHASH_UNCHANGED_THRESHOLD=10

# ── 编排层：异常现场上报（Task 14）─────────────────────────────
# 异常现场包根目录：默认空=不落盘（NoopIncidentReporter，零回归）；
# 设路径启用 FileIncidentReporter（停滞超阈值时落 incident.json + 截图副本）。
INCIDENT_DIR=
# 异常上报附带的最近步骤窗口大小（metadata.recent_steps）
INCIDENT_STEP_WINDOW=10

# ── 模型接入（Task 10，模型 ID 走 .env 不硬编码）───────────────
# Anthropic API Key（接真模型时必填；缺失时任务优雅回退 FAILED 不崩）
ANTHROPIC_API_KEY=
# Supervisor 编排 LLM（默认 Opus 4.8）
DESKTOP_SUPERVISOR_MODEL=claude-opus-4-8

# ── zero-link · external_priors 多模态先验流注入（Q3，M3/M6）──────────────────
# MCP 侧 build_external_priors_override() 客户端 fail-fast 阈值，与 Zero 侧同名旋钮
# 一致（同一 env 名·两仓同步）。默认注释=用代码内默认（对齐 Zero 零回归）。
# M3 单条外部先验精度上界（Πv/Πa ≤ cap，超出 fail-fast）；默认 0.8，与 Zero 一致。
# ZERO_EXTERNAL_PRIOR_PRECISION_CAP=0.8
# M6 每轮外部流数上界（len ≤ max，超出 fail-fast）；默认 5，与 Zero 一致。
# ZERO_MAX_EXTERNAL_STREAMS=5
#
# 各模态推荐精度默认（design.md §五·三席调和；感知侧盖精度参考，recommended_precision 读取）。
# physio Πv 在**本仓侧就直接钉死** MIN_PRECISION(1e-3)（external_priors.py::
# recommended_precision 的 PHYSIO 分支，连 getenv 都不做；行号会腐烂故只记符号名），
# Zero M2 侧另有同向覆写。故该旋钮是纯文档记号，设任何值都不生效。
# EXTERNAL_FACE_PRECISION_V=0.20     # 视觉 face valence Πv（EmoNet 较丰，保守取中）
# EXTERNAL_FACE_PRECISION_A=0.12     # 视觉 face arousal Πa（AU 与唤醒对应弱于 valence）
# EXTERNAL_AUDIO_PRECISION_V=0.10    # 语音 audio valence Πv（F0/能量难区分正负，保守取低）
# EXTERNAL_AUDIO_PRECISION_A=0.25    # 语音 audio arousal Πa（F0/能量=交感输出，信噪比高）
# EXTERNAL_PHYSIO_PRECISION_V=0.001  # ⚠ 无效旋钮：本仓不读（钉死 MIN），仅记录语义（对效价盲）
# EXTERNAL_PHYSIO_PRECISION_A=0.18   # 生理 physio arousal Πa（交感唤醒较可靠，保守取低）
#   ⚠ 上面这条 physio Πa 在 **EDA 与 HRV 同时在场时不生效**（即默认路径）：二者会先经
#   ω=0.5 协方差交叉（CI）预合并为单条 physio 流，合并精度取子源可靠度分层常量
#   PHYSIO_SUBSOURCE_PRECISION_A={eda:0.15, hrv:0.20}（external_priors.py），得 Πa=0.175。
#   只有「单独只有 EDA 或只有 HRV」的非合并支路才读本 env。要改线上生理精度须改那张分层表。
#   预合并依据：Zero 科学家议会 2026-07-28 终裁（EDA/HRV 相关，朴素双流会虚增精度 2 倍）。
#   ⚠ **调参预警：Πa 有一条比 M3 cap(0.8) 低得多的硬顶 ≈0.359**——单流（本 env）或合并后
#   （分层表）的出线 Πa 一旦 ≥ 该值，build_external_priors_override 的 **M8 守卫直接 raise**，
#   载荷发不出去。因为该 Πa 已使 physio 流**不经任何开门动作**即可越过 Zero 点燃门
#   SALIENCE_THRESHOLD=0.18（最坏情形 |μa|=1），绕过 Zero 应我方「EDA 反号宁可门掉」之请
#   所落的 D7 排除承诺（D7 只写在门开分支，门关这条默认路径它管不到）。
#   0.359 是「出线 μv=0」这一特例下的闭式解，M8 实际按 hypot(μv,1) **现算**：μv 若变非零，
#   硬顶自动收紧到 2·0.18/√2 − 1e-3 = 0.2535584412271571（对外文书写作 0.2536 = 向上取整）。
#   真要抬到硬顶之上须先跨仓与 Zero 确认——契约级语义变更，非本仓可单方面调的参数。
#
# EDA/HRV 预合并的 CI 权重 ω。**终裁值 0.5，生产勿改**——它是唯一不重复计可靠度的取值
# （ω=0.5 时 μ 与「不合并双流」逐位相同、Π 精确减半，只调保守度一个维度；任何 ω≠0.5 会
# 同时扰动 μ）。0.571 / 0.4286 两档是「同一个错误的两个方向」，均已作废。仅供实验对照。
# ZERO_PHYSIO_MERGE_OMEGA=0.5

# ── zero-link · §5.1 感知模型通道（physio/audio/vision 均真接入）────────────
# feature flag：false=禁用（默认，零回归），true=启用对应通道感知
ZERO_PHYSIO_CHANNEL_ENABLED=false
ZERO_AUDIO_CHANNEL_ENABLED=false
ZERO_VISION_CHANNEL_ENABLED=false
#
# ⚠ EDA 唤醒度量**无 env 开关**（2026-07-29 起）：EdaChannel 只有一条路径 = scl_baseline_delta
#   （窗内 SCL 均值 − 窗间中位数基线，不做 phasic 分解）。旧的 ZERO_EDA_AROUSAL_METRIC 与
#   scr_amplitude 实现已删除——后者经 WESAD 真被试实测读数与唤醒**系统性反相关**
#   （「stress>baseline」正确率 1/5，经典 SCL 4/5），无保留价值。
#   现度量四判据全面胜过「裸 SCL 无修正」对照臂（判别 10/10 vs 9/10 · 抗漂移 0.050 vs 0.324
#   · 持续比 +1.010 vs +0.966 · 跨被试极差 0.548 vs 1.745）。
#   ⚠ 运行期须知：冷启动约 4.5 分钟返回 None（有意的诚实降级，期间 merge_physio_priors 退为
#   裸 hrv/rmssd）；baseline_horizon 默认 1800s 须舒适超过典型唤醒事件，45 分钟以上的持续
#   唤醒是否击穿该值，WESAD 数据集无法验证。
#   详见 notes/2026-07-28-eda-metric-redesign-blueprint.md 与 -eda-v2-probe-p0-p2-results.md。
#
# 语音模型：audeering w2v2 维度 SER（HF 模型 id 或本地快照目录）。空=不启用真推理（回退 None）。
# Wav2Small 蒸馏 ONNX 在 HF 无可下载权重（仅模型卡）→ 落回文献门 option B 已核验的 audeering。
# gap-2 已现场核验：输出字段序 [arousal,dominance,valence]，μv/μa 不反转（见通道 docstring）。
# ⚠ 该模型 ~630MB torch 权重；首次 from_pretrained 会下载到 HF 缓存。
# ZERO_AUDIO_MODEL_PATH=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
#
# 视觉模型：EmotiEffLib ONNX 多任务模型名（须为 *_va_mtl 才有 VA 输出）。默认 enet_b0_8_va_mtl。
# ZERO_VISION_MODEL_NAME=enet_b0_8_va_mtl
# 视觉模型自定义/离线缓存目录（空=默认 ~/.emotiefflib，首次自动从 GitHub 下载 .onnx）。
# gap-1 已绕过：用 ONNX 后端零 timm 依赖，不碰共用 env 的 D:\Zero 依赖（绝不 conda prune）。
# ZERO_VISION_MODEL_DIR=

# ── 测试期开关（仅跑测试用，产品码不读）────────────────────────────────────────
# 跨仓对齐/联调核查时设 1 跑一次：zerorepo 用例的**任何 skip 一律转 fail**，
# 防「覆盖静默归零」（实现见 tests/mcp/conftest.py:25-31；pyproject 的 addopts=-ra 同源）。
# ZERO_LINK_E2E_STRICT=1

# ── zero-link · Zero MCP Client（Task 1-4）──────────────────────────────────
# feature flag：false=禁用（默认），true=启用 Zero MCP 连接
ZERO_LINK_ENABLED=false
# 传输层选择：stdio（默认，spawn 子进程）| http（远程 Streamable HTTP）
ZERO_LINK_TRANSPORT=stdio
#
# stdio 模式（ZERO_LINK_TRANSPORT=stdio）：启动 Zero 侧 MCP server 子进程
# ZERO_SERVER_COMMAND=   # server 可执行文件，默认 sys.executable（当前 Python）
# ZERO_SERVER_ARGS=["-m","src.mcp_server"]  # server 启动参数 JSON 列表（临时占位，Zero 建 server 后覆盖）
# ZERO_SERVER_CWD=D:\Zero               # server 工作目录（Zero 仓根）
#
# http 模式（ZERO_LINK_TRANSPORT=http）：连接远程 Zero MCP server
# ZERO_HTTP_ENDPOINT=http://localhost:8000/mcp  # Zero MCP server Streamable HTTP endpoint
# ZERO_HTTP_TOKEN=                              # Bearer token（空=不发 Authorization 头）
#   ⚠ 跨仓映射（2026-07-22 Zero 回执 · 2026-07-25 复核）：本仓 client 的 ZERO_HTTP_TOKEN 须与 Zero
#   server 侧 ZERO_MCP_HTTP_TOKEN **同值**（两仓命名空间不同，值必须一致，否则 401）。
#   Zero server 鉴权三态（口径同步自 Zero `src/mcp_server/auth.py::resolve_enforced_token`
#   这一纯函数，2026-07-25 现场核验、2026-07-29 复核仍成立；跨仓引用一律只写符号名不写行号）：
#     ① 设了 token         → 强制鉴权，**即便 loopback**（显式配置即启用）；token 须纯 ASCII，否则 fail-fast
#     ② 未设 + loopback     → 免鉴权（loopback = localhost / 127.0.0.0/8 / ::1，不止 127.0.0.1）
#     ③ 未设 + 非 loopback  → 启动 fail-fast（如 0.0.0.0），拒绝对外开无鉴权裸端口
#   鉴权失败=传输层 HTTP 401（非工具层 ToolError）→ client 侧走连接错误（ZeroLinkConnectionError），
#   不走 graceful_step。⚠ 该性质**仅连接期**成立：会话中途轮换 token 导致的 401 会被 graceful_step
#   降级为 None（client.py:559-565，有 warning 日志），表现为情感通道悄悄失效——轮换 token 须重连。
#
# 透传给 Zero server 的**能力门控**（本仓不读，只经 client.py:115 整份 os.environ 带给子进程；
# http 模式下须在 Zero server 侧自己设）。⚠ 前四项不设 → Zero 走**占位路径**（prosody 出
# 'ratio' 方言、facs_au 只出象限相关子集、physiology 出 legacy 形状）：mapper 能正常消费，
# 风险不是「空数据」而是**量纲/标度降级**（legacy sc 须配 skin_conductance_max_us=1.0，见 W6）。
# ZERO_MCP_WORKSPACE_ENABLED 是例外——Zero 侧**默认即开**，不设即生效。
# 名称与取值口径见 tests/mcp/test_zero_client_e2e.py。
# ZERO_FACS_MODEL_PATH=            # 真 FACS 权重；不设 → facs_au 非真模型输出（用例 :276）
# ZERO_FACS_EXTENDED=true          # 配合上一项出全 13 键 facs_au（用例 :277）
# ZERO_PROSODY_MODEL_PATH=         # 设了 prosody_scale 才翻 'normalized'（用例 :321,:333）
# ZERO_PHYSIOLOGY_MODEL_PATH=      # 真 WESAD decoder → canonical physiology（用例 :426）
# ZERO_PHYSIOLOGY_CANONICAL_PLACEHOLDER=true  # 无真模型时出 canonical 形状占位（Zero b503990，用例 :369）
# ZERO_MCP_WORKSPACE_ENABLED=true  # Zero 侧漂移驱动门控，**默认即开**；关掉会让观测量不漂移（用例 :647）
#
# 透传给 Zero server 的会话持久 env（stdio 模式下 client 整份传 os.environ 给子进程，见
# src/mcp/zero/client.py:107-118；http 模式下须在 Zero server 侧自己设）。**不设=默认 memory
# 后端**：同一 session_id 重开也是全新会话（Zero InMemorySaver 进程内），跨重启 resume 不生效。
# ZERO_CHECKPOINT_BACKEND=sqlite   # memory（默认）| sqlite（跨重启持久，AsyncSqliteSaver）| postgres（Zero 侧未实现，构造期 NotImplementedError）
# ZERO_CHECKPOINT_DB=              # sqlite 落盘路径；⚠ 相对路径按 **Zero server 的 cwd**（ZERO_SERVER_CWD）解析，建议给绝对路径

# ─────────────────────────────────────────────────────────────────────────────
# 本仓持久化（记忆层 + 存储层接线，src/orchestration/persistence.py）
# ─────────────────────────────────────────────────────────────────────────────
# **不设 = 关**：图使用 NoopMemoryAPI + snapshot_store=None 打桩（零回归，既有行为不变）。
# 设了则 memory_flush_node 的会话摘要真落库、感知快照真持久化。
# 与上面 ZERO_CHECKPOINT_* 无关：那是**透传给 Zero server** 的会话运行态；这里是**本仓自己的**
# 长期记忆与快照存储（运行态与长期记忆分离，memory-rules 第 3 条）。
# ZERO_MCP_PERSISTENCE_DB=          # SQLite 路径（如 var/zero_mcp.db）；:memory: 亦可；父目录自动创建
# ZERO_MCP_MEMORY_SCOPE_KEY=        # 记忆作用域键（user/session/group 的"哪一个"）。
                                    # ⚠ 开了上面的 DB 就**必填**，缺失即启动 fail-fast——
                                    # 静默退打桩会让你以为记忆开了、实则整轮没写。

# ─────────────────────────────────────────────────────────────────────────────
# 日志（本仓自读，src/logging_config.py::configure_logging，入口点统一配置）
# ─────────────────────────────────────────────────────────────────────────────
# **已接线**（src/logging_config.py 的 resolve_log_level/resolve_log_file 读 os.environ；
# 入口调用点：src/mcp/desktop_mcp_server.py 的 __main__ 块，**接管语义**——摘掉 FastMCP
# 抢注的 RichHandler 统一为本仓格式）。库模块不读这两个变量。
# 前缀取 ZERO_MCP_（与上节 ZERO_MCP_PERSISTENCE_* 同域）。⚠ 该前缀**非本仓独占**：
# Zero 侧也把 ZERO_MCP_* 用作其 MCP 面配置域（其通用日志走 ZERO_LOG_LEVEL）；已核验
# （2026-07-30，Zero HEAD 908409a）对方现有 ZERO_MCP_* 与这两个名字无精确同名冲突。
# 透传语义：**本仓 client 显式整份透传 os.environ** 给 spawn 的子进程（desktop 与 zero
# 两侧 _build_subprocess_env 同构）故子进程同样生效；外部 host 按 MCP SDK 默认最小 env
# spawn 本仓 server 时不继承，回默认 INFO/不落盘。
# 级别：DEBUG|INFO|WARNING|ERROR|CRITICAL（大小写不敏感）。不设/空=INFO；
# 非法值启动即 ValueError fail-fast（不静默回落）。⚠ DEBUG 下第三方 httpx/httpcore/mcp
# 命名空间被钉在 INFO（防请求头含 Bearer token 倾倒进日志；mcp SDK 个别裸名 logger
# 不在层级内，覆盖面细则见 src/logging_config.py 注释）。
# ZERO_MCP_LOG_LEVEL=INFO
# 落盘路径。不设/空=不落盘（仅 stderr——stdio 模式 stdout 是协议线路不可写）。
# 设置后 UTF-8 RotatingFileHandler（10MB×5，工程假设），父目录自动创建。
# ZERO_MCP_LOG_FILE=
