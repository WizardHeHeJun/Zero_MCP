# Zero_MCP 配置模板 —— 复制为 .env 启用（.env 已 gitignore，勿提交真实值）。
# 本轮为骨架占位，随实现补充真实变量。所有 secret/endpoint/模型 ID 一律走这里，不硬编码。

# ── 与 Zero 互操作（经 MCP）──
# ZERO_MCP_ENDPOINT=              # Zero 暴露的 MCP endpoint（Streamable HTTP）；留空=未接
# ZERO_MCP_TRANSPORT=stdio        # stdio | http

# ── LLM（Anthropic Claude；模型 ID 走 .env，不硬编码）──
# ANTHROPIC_API_KEY=              # 必填（接真模型时）
# ZERO_MCP_MODEL=claude-opus-4-8  # 默认 Opus 4.8；备选 claude-sonnet-4-6 / claude-haiku-4-5-20251001

# ── MCP 服务层（TS mcp-server/）──
# MCP_SERVER_PORT=3000            # Streamable HTTP 监听端口

# ── 存储后端（随 src/storage 实现补充）──
# ZERO_MCP_CHECKPOINT_BACKEND=memory   # memory | sqlite | postgres
