# Zero_MCP 环境变量模板：复制为 .env 并填值（.env 已 gitignore，不提交）。
# ⚠ 本仓不调用 load_dotenv——写进 .env 不自动生效，须由宿主注入进程环境。
# 各键的语义细节、默认值依据与调参陷阱见 README「配置详解」。

# ── 桌面屏幕能力 ─────────────────────────────────────────────
SCREEN_CAPABILITY_ENABLED=false     # 总开关，false=禁用（默认）
PERCEPTION_DEVICE=auto              # auto（CUDA>DML>CPU）| cpu | dml | cuda
SCREENSHOT_TMP_DIR=                 # 截图临时目录，空=系统 TEMP
UIA_HOLLOW_THRESHOLD=3              # 一层子元素数 ≤ 该值判 UIA hollow
OMNIPARSER_MODEL_DIR=               # 空=不启用 OmniParser
OMNIPARSER_MIN_VRAM_MB=4096         # OmniParser 最低显存要求（MB）

# ── 编排层：状态窗口 ─────────────────────────────────────────
STATE_STEP_KEEP=20                  # Checkpointer 保留的最大步骤数
STALL_MAX_STEPS=5                   # 停滞检测：最大步骤数
STALL_THRESHOLD=3                   # 停滞检测：相似步骤阈值
DESKTOP_MAX_ITERATIONS=30           # 回路硬上限：Supervisor 规划轮次上限，命中以 failure_reason=max_iterations_exceeded 收口（调用方 recursion_limit 须 ≥ 3×上限+裕量）
# CONTEXT_STEP_WINDOW=10            # ⚠ 未接线，设了无效（只能走 PromptLoader 入参，见 README）

# ── 编排层：安全门 TOCTOU ────────────────────────────────────
TOCTOU_WAIT_MS=200                  # 两次截图间隔（实测安全下限）
TOCTOU_HASH_THRESHOLD=0.1           # phash 差异超此值判篡改 abort；⚠ 勿为容忍动画调高
TOCTOU_CROP_HALF_PX=150             # 坐标动作局部裁剪半径（像素）；无 target_bbox 时回退用
TOCTOU_CROP_MIN_MARGIN_PX=20        # 有 target_bbox 时 bbox 外扩量（像素）；真机标定值，勿调大——
                                     # margin 越大越稀释目标内小变化（同 300×300 固定邻域盲区因果链）
TOCTOU_SNAPSHOT_MAX_AGE_MS=5000     # 感知快照复用新鲜度上界，超龄丢弃重拍

# ── Agent 层：像素锚点验证 ───────────────────────────────────
ANCHOR_EDIT_DISTANCE_RATIO=0.34     # 编辑距离容错比例；模块导入时读取，改后须重启

# ── 编排层：停滞检测信号 A ───────────────────────────────────
PHASH_UNCHANGED_THRESHOLD=10        # phash 汉明距离 < 该值视为画面未变化

# ── 编排层：异常现场上报 ─────────────────────────────────────
INCIDENT_DIR=                       # 空=不落盘（默认）；设路径启用现场包落盘
INCIDENT_STEP_WINDOW=10             # 现场包附带的最近步骤窗口大小

# ── 模型接入（模型 ID 走 .env 不硬编码）──────────────────────
ANTHROPIC_API_KEY=                  # 缺失=优雅回退（不崩溃、任务以 FAILED 收口）
DESKTOP_SUPERVISOR_MODEL=claude-opus-4-8
# DESKTOP_SUPERVISOR_MODEL_FALLBACK=claude-sonnet-4-6  # 备用模型：主模型调用异常时切换重试一次（不递归）；空=无备用
# DESKTOP_ACTION_GENERATOR_MODEL=          # ActionSpec 生成层模型；空=同 DESKTOP_SUPERVISOR_MODEL（工程假设，选型待标定）
# DESKTOP_ACTION_GENERATOR_MODEL_FALLBACK= # 生成层备用模型；空=同 DESKTOP_SUPERVISOR_MODEL_FALLBACK

# ── zero-link · external_priors 多模态先验（与 Zero 同名旋钮同值）──
# 默认注释=用代码内默认（对齐 Zero 零回归）。
# ZERO_EXTERNAL_PRIOR_PRECISION_CAP=0.8   # M3 单条先验精度上界
# ZERO_MAX_EXTERNAL_STREAMS=5             # M6 每轮外部流数上界
# EXTERNAL_FACE_PRECISION_V=0.20
# EXTERNAL_FACE_PRECISION_A=0.12
# EXTERNAL_AUDIO_PRECISION_V=0.10
# EXTERNAL_AUDIO_PRECISION_A=0.25
# EXTERNAL_PHYSIO_PRECISION_V=0.001       # ⚠ 无效旋钮：本仓钉死 MIN_PRECISION，见 README
# EXTERNAL_PHYSIO_PRECISION_A=0.18        # ⚠ 默认路径（EDA+HRV 同在）不读此值；Πa 有 ≈0.359 硬顶，见 README
# ZERO_PHYSIO_MERGE_OMEGA=0.5             # ⚠ 终裁值，生产勿改，见 README

# ── zero-link · 感知模型通道 ─────────────────────────────────
ZERO_PHYSIO_CHANNEL_ENABLED=false   # false=禁用（默认，零回归）
ZERO_AUDIO_CHANNEL_ENABLED=false
ZERO_VISION_CHANNEL_ENABLED=false
# ZERO_AUDIO_MODEL_PATH=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim  # 空=不启用真推理；首载 ~630MB
# ZERO_VISION_MODEL_NAME=enet_b0_8_va_mtl   # 须 *_va_mtl 才有 VA 输出
# ZERO_VISION_MODEL_DIR=                    # 空=默认 ~/.emotiefflib，首次自动下载

# ── 测试期开关（仅跑测试用，产品码不读）──────────────────────
# ZERO_LINK_E2E_STRICT=1            # zerorepo 用例任何 skip 一律转 fail

# ── zero-link · Zero MCP Client ──────────────────────────────
ZERO_LINK_ENABLED=false             # false=禁用（默认）
ZERO_LINK_TRANSPORT=stdio           # stdio（子进程）| http（远程 Streamable HTTP）
# stdio 模式（用能跑 Zero 的解释器拉起其 server 子进程）：
# ZERO_SERVER_COMMAND=              # 默认 sys.executable；建议给 Zero 运行环境 python 的绝对路径
# ZERO_SERVER_ARGS=["-m","src.mcp_server"]
# ZERO_SERVER_CWD=                  # Zero 仓根目录
# http 模式（仅 ZERO_LINK_TRANSPORT=http 时生效）：
# ZERO_HTTP_ENDPOINT=http://localhost:8000/mcp
# ZERO_HTTP_TOKEN=                  # ⚠ 须与 Zero 侧 ZERO_MCP_HTTP_TOKEN 同值；鉴权三态见 README
#
# 透传给 Zero server 的能力门控（本仓不读；不设走占位路径，标度风险见 README。
# 权重在 Zero 仓 artifacts/ 下，三条都设 → 全走真模型 canonical 形状）：
# ZERO_FACS_MODEL_PATH=             # <Zero 仓根>\artifacts\facs_decoder_ext_v2.pt
# ZERO_FACS_EXTENDED=true
# ZERO_PROSODY_MODEL_PATH=          # <Zero 仓根>\artifacts\prosody_decoder.pt
# ZERO_PHYSIOLOGY_MODEL_PATH=       # <Zero 仓根>\artifacts\physiology_decoder.pt
# ZERO_PHYSIOLOGY_CANONICAL_PLACEHOLDER=true  # 无真 physiology 权重时的 canonical 占位门
# ZERO_MCP_WORKSPACE_ENABLED=true   # Zero 侧默认即开
#
# 透传给 Zero server 的会话持久化（与本仓 ZERO_MCP_PERSISTENCE_* 无关，见 README）：
# ZERO_CHECKPOINT_BACKEND=sqlite    # memory（默认，重启不 resume）| sqlite | postgres（Zero 未实现）
# ZERO_CHECKPOINT_DB=               # ⚠ 相对路径按 Zero server 的 cwd 解析，建议绝对路径

# ── 本仓持久化（记忆层 + 存储层接线）─────────────────────────
# ZERO_MCP_PERSISTENCE_DB=          # 不设=关（Noop 打桩，零回归）；SQLite 路径或 :memory:
# ZERO_MCP_MEMORY_SCOPE_KEY=        # ⚠ 开了上面的 DB 就必填，缺失启动 fail-fast

# ── 日志 ─────────────────────────────────────────────────────
# ZERO_MCP_LOG_LEVEL=INFO           # DEBUG|INFO|WARNING|ERROR|CRITICAL；非法值 fail-fast
# ZERO_MCP_LOG_FILE=                # 空=仅 stderr；设置后 UTF-8 轮转落盘（10MB×5）

# ── TS MCP 对外聚合层（mcp-server/，v1）───────────────────────
# 拓扑：外部 host ─(Streamable HTTP, stateless, Bearer 三态)→ TS 聚合器
# ─(stdio 子进程 ×2)→ vts_behavior_mcp_server / desktop_mcp_server。
# 工具对外 = 两后端并集加前缀 vts__ / desk__（如 vts__behavior_trigger、
# desk__screen_snapshot）。这些 env 只被 mcp-server/ 读取，本仓 Python 侧不读。
ZERO_MCP_AGGREGATOR_ENABLED=false   # false=禁用（默认）；true 才起 HTTP + spawn 后端
ZERO_MCP_AGGREGATOR_HOST=127.0.0.1  # 监听 host；鉴权三态见下
ZERO_MCP_AGGREGATOR_PORT=8850
ZERO_MCP_AGGREGATOR_PATH=/mcp
# ZERO_MCP_AGGREGATOR_TOKEN=        # Bearer token；鉴权三态（镜像 Zero
#   src/mcp_server/auth.py::resolve_enforced_token）：①设了 token→恒强制鉴权
#   （即便 loopback，非 ASCII fail-fast）；②未设+loopback（127.0.0.0/8/::1/
#   localhost）→免鉴权；③未设+非 loopback（如 0.0.0.0）→启动 fail-fast，拒绝
#   对外开无鉴权裸端口。
ZERO_MCP_AGGREGATOR_VTS_BACKEND_ENABLED=true
ZERO_MCP_AGGREGATOR_VTS_COMMAND=python
# ZERO_MCP_AGGREGATOR_VTS_ARGS=["-m","src.mcp.vts_behavior_mcp_server"]
# ZERO_MCP_AGGREGATOR_VTS_CWD=      # 默认本仓根目录
ZERO_MCP_AGGREGATOR_DESKTOP_BACKEND_ENABLED=true
ZERO_MCP_AGGREGATOR_DESKTOP_COMMAND=python
# ZERO_MCP_AGGREGATOR_DESKTOP_ARGS=["-m","src.mcp.desktop_mcp_server"]
# ZERO_MCP_AGGREGATOR_DESKTOP_CWD=  # 默认本仓根目录
ZERO_MCP_AGGREGATOR_BACKEND_START_TIMEOUT_MS=15000  # spawn+listTools 握手超时
ZERO_MCP_AGGREGATOR_BACKEND_RESTART_MAX=3           # 指数退避重启上限（1s/2s/4s…），耗尽即永久 unavailable

# ── VTube Studio Live2D 渲染终端 ─────────────────────────────
VTS_SINK_ENABLED=false              # false=禁用（默认，零回归）
VTS_API_URL=ws://127.0.0.1:8001     # VTS Public API WebSocket 地址
VTS_TOKEN_FILE=.vts_token           # 插件授权 token 落盘路径（相对进程 cwd）
VTS_SINK_MODEL=                     # VTS 列表显示名；空=不动当前模型
VTS_SINK_EXPRESSIVENESS=1.0         # 1.0=忠实 AU 幅度；演示观感建议 1.5~2.0
VTS_SINK_APPLY_INTENSITY=true       # 按 facs_au["intensity"] 作全局增益
VTS_SINK_AMBIENT_MOTION=true        # 微表情环境层（眨眼/呼吸/微噪声）

# ── 离散行为层（VTS behavior MCP server，复用上面 VTS_* 连接键）──
VTS_BEHAVIOR_ENABLED=false          # ⚠ 工具始终注册，关时运行时拒绝 [vtsb:disabled]；双插件冲突见 README
VTS_BEHAVIOR_HOTKEYS=true           # 热键枚举/触发开关（模型无热键则零影响）
VTS_SPEECH_ENABLED=false            # speech_play 语音播放；⚠ 需与上面 VTS_BEHAVIOR_ENABLED 同时为
                                     # true 才可用（双 flag 复合门），关时拒绝 [vtsb:speech_disabled]；
                                     # 依赖走 extra `speech`（sounddevice，与麦克风采集用的 hardware-audio
                                     # 同包不同开关，见 pyproject.toml 注释）
