# Zero_MCP 环境变量模板
# 复制此文件为 .env 并填入实际值；.env 已 gitignore，不提交。

# ── 桌面屏幕能力（Task 3-6）────────────────────────────────────────────────────
# feature flag：false=禁用（默认），true=启用所有桌面工具
SCREEN_CAPABILITY_ENABLED=false

# 感知设备选择：auto（CUDA>DML>CPU 自动降级）| cpu | dml | cuda
PERCEPTION_DEVICE=auto

# 截图临时目录（空=系统 TEMP/zero_mcp_screenshots/）
SCREENSHOT_TMP_DIR=

# UIA 空洞探测阈值：一层子元素数 ≤ 该值时判 hollow（工程假设初值 3）
UIA_HOLLOW_THRESHOLD=3

# OmniParser 本地模型目录（空=不启用 OmniParser）
OMNIPARSER_MODEL_DIR=

# OmniParser 启用所需最低 GPU 显存（MB，工程假设初值 4096）
OMNIPARSER_MIN_VRAM_MB=4096

# ── 编排层状态窗口（orchestration，待 src/orchestration 实现后生效）─────────────
# Checkpointer 保留的最大步骤数
STATE_STEP_KEEP=20

# 注入上下文的步骤窗口大小
CONTEXT_STEP_WINDOW=10

# 停滞检测：最大步骤数
STALL_MAX_STEPS=5

# 停滞检测：相似步骤阈值
STALL_THRESHOLD=3

# ── 编排层：安全门 TOCTOU（Task 7）─────────────────────────────
# 两次截图间隔（毫秒）。Task 12 实测：单快照延迟 ~1.2s，200ms 是安全下限，保留。
TOCTOU_WAIT_MS=200
# 感知哈希差异阈值：delta > 该值判定画面被篡改则 abort。
# Task 12 实测（notes/e2e-desktop-task-results.md §四.2/§五）：现代应用窗口自身有
# 持续动效（动画/红点/时钟），全窗口 phash 无静止基线（钉钉 delta 在 0/0.47 间跳）。
# 故坐标动作按 TOCTOU_CROP_HALF_PX 邻域局部裁剪比对，0.1 在该口径下成立；
# 不要为容忍动画调高此值——会失去对真实劫持的敏感度。
TOCTOU_HASH_THRESHOLD=0.1
# 坐标动作 TOCTOU 裁剪半径（像素）：以点击点为中心 2N×2N 邻域取 hash。
# 工程假设初值：覆盖常见按钮/菜单目标、小于动画区典型距离；动效恰在目标上时
# abort 是正确行为（目标不稳定不该点）。
TOCTOU_CROP_HALF_PX=150

# ── 编排层：停滞检测信号 A（Task 10）───────────────────────────
# phash 汉明距离 < 该值视为画面未变化。同受应用动画影响（同窗口级 hash 局限，
# 待与 TOCTOU 一并评估元素级裁剪口径，Task 12 §四.2）。
PHASH_UNCHANGED_THRESHOLD=10

# ── 编排层：异常现场上报（Task 14）─────────────────────────────
# 异常现场包根目录：默认空=不落盘（NoopIncidentReporter，零回归）；
# 设路径启用 FileIncidentReporter（停滞超阈值时落 incident.json + 截图副本）。
INCIDENT_DIR=
# 异常上报附带的最近步骤窗口大小（metadata.recent_steps）
INCIDENT_STEP_WINDOW=10

# ── 模型接入（Task 10，模型 ID 走 .env 不硬编码）───────────────
# Anthropic API Key（接真模型时必填；缺失时任务优雅回退 FAILED 不崩）
ANTHROPIC_API_KEY=
# Supervisor 编排 LLM（默认 Opus 4.8）
DESKTOP_SUPERVISOR_MODEL=claude-opus-4-8
