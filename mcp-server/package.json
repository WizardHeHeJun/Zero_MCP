{
  "name": "zero-mcp-server",
  "version": "0.0.0",
  "description": "Zero_MCP 的 MCP 服务层（TS）——经 @modelcontextprotocol/sdk 暴露/转发新 Agent 能力。v1：TS 对外聚合器，经 Streamable HTTP 暴露两个 stdio 子进程后端（vts / desktop）的工具并集。",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^26.2.0",
    "vitest": "^4.1.10",
    "eslint": "^10.8.1",
    "typescript-eslint": "^8.67.0",
    "prettier": "^3.9.6"
  }
}
